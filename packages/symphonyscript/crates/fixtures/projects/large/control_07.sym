state setpoint_25(0.5)
state phase_25(0)
state alarm_25(false)
state manual_25(false)
state pressures_25([]): f32[..10]
stream reading_25(0.0)
channel[16] fault_25(0)
state demand_25 = setpoint_25 * 0.9
state error_25 = reading_25 - setpoint_25
state lowest_25 = for x in pressures_25 into low from 100.0: min(low, x)
state trend_25 = reading_25.past(1, 0.0) - reading_25.past(2, 0.0)
state mode_25 = if manual_25 then Mode::Manual else Mode::Auto
state gainset_25 = match mode_25:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_25([]) = (history_25.past(1) + [phase_25])[^4..]
stream faults_25 = fault_25 + 1

let ratios_25 = [0.1, 0.25, 0.5, 0.75]
let limits_25 = ratios_25 + [1.0]
let tail_25 = limits_25[2..]
let tag_25 = "plant 25: {tail_25.size}"
let rated_25 = [2kpa, 500pa]
let heavy_25 = if rated_25[0] > 1kpa then 0.5 else 0.25

fn tier_25(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_25(x): 10 ** (x / 20)
fn depth_25(n): if n < 1 then 0 else 1 + depth_25(n - 1)
fn bounded_25(x): clamp(x, 0.0, 1.0)

pattern Bank_25(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_25(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_25 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_25 * 0.01)
    Controller as loop /(demand_25) | gain=gainset_25:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_25(error_25 + trend_25)) | gain=ratio_25(-6)
    for i in 0..4:
        Valve/(ratios_25[i])
    for i, r in tail_25:
        Valve/(r * 0.5) when alarm_25
    Loop_25/(setpoint_25) | gain=heavy_25
    when alarm_25:
        Valve/0.9
    else:
        Valve/(faults_25 * 0.01)
    when:
        phase_25 is 0: Valve/0.6
        phase_25 is 1: Valve/0.7
        else: Valve/(history_25[0] * 0.1)

Plant trim_25:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_25: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_25 manifold_25 /0
Bank_25 header_25 /(tier_25(25) * 0.001)

Plant spare_25 | mode=Off:
    Valve/(depth_25(3) * 0.1)

