state section_34(0)
state fill_34(false)
state cutoff_34(0.5)
state drive_34(0.25)
state held_34([]): i32[..12]
stream pulse_34(0)
channel[8] hits_34(0)
state swing_34 = cutoff_34 * 0.8
state bright_34 = if fill_34 then swing_34 else cutoff_34.past(1, 0.5)
stream beat_34 = pulse_34 + hits_34
state last_34 = section_34.past(1, -1)
state recent_34([]) = (recent_34.past(1) + [section_34])[^8..]
state peak_34 = for x in recent_34 into top from 0: max(top, x)
state played_34 = held_34 + [last_34]
state rising_34 = for i in 1..held_34.size into n from 0: if held_34[i] > held_34[i - 1] then n + 1 else n
state mood_34 = match section_34 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_34 = match fill_34:
    true: Wave::Saw
    false: Wave::Sine

let scale_34 = [0, 2, 4, 5, 7, 9, 11]
let chords_34 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_34 = 36 + 34 % 12
let span_34 = scale_34 + [12, 14, 16]
let upper_34 = span_34[3..8]
let lower_34 = span_34[..3]
let label_34 = "part 34"
let title_34 = "{label_34} in {root_34}"
let lengths_34 = [1bars, 2, 0.5bars]

fn degree_34(i): root_34 + scale_34[i % 7] + 12 * (i div 7)
fn fib_34(n): if n < 2 then n else fib_34(n - 1) + fib_34(n - 2)
fn level_34(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_34(i, shift = 0):
    let base = chords_34[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_34(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_34 = [fib_34(3), fib_34(4), fib_34(5), fib_34(6)]
let total_34 = for s in steps_34 into sum from 0: sum + s
let ladder_34 = for i in 0..6 into kept from []: kept + [degree_34(i)]
let voiced_34 = chord_34(34, 12)

pattern Arp_34(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_34(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_34

pattern Stab_34(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_34 | gain=0.9:
    Note/(root_34) Note/(root_34 + 4) Note/(root_34 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_34(1)) Note as top /(degree_34(3)) Note'/(degree_34(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_34)
    (Note' as mark /61 when fill_34 | velocity=0.5)
    Note/(section_34 + 1)
    Note'/62 | velocity=level_34(drive_34) brightness=bright_34
               length=2bars
    Note/(peak_34 + root_34) | length=lengths_34[0]
    Arp_34/(root_34) | steps=3
    Arp_34/(root_34 + 12) | gap=gap_34(34)
    Plays | transpose=5: verse_34
    Starts: [verse_34, chorus_34][section_34]

Clip verse_34:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_34
    for i in 0..8:
        Note/(degree_34(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_34:
        Note/(root_34 + p) | brightness=0.1 * i
    Voice_34 as low /(root_34)
    Voice_34/(root_34 + 7) | steps=2
    Stab_34/(voiced_34[0]) | loud
    Plays: chorus_34

Clip chorus_34 | gain=verse_34.gain * 1.2:
    Note/72 | velocity=verse_34.hook.velocity
    for c in chords_34:
        [Note/(root_34 + c[0]) Note/(root_34 + c[1]) Note/(root_34 + c[2])]
    when fill_34:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_34 is 0: Note/77
        section_34 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_34[i])]
    Plays as back | transpose=-2: verse_34
    Plays: bridge_34
    Plays | gain=to.hook.velocity: verse_34

Clip bridge_34 | level=mood_34:
    for i in 0..total_34:
        Note/(root_34 + i % 12) | velocity=0.5 length=lengths_34[1]
    Note/(played_34[0]) | velocity=level_34(cutoff_34, 0.2)
    Note/(rising_34 + 40)
    Plays when fill_34: intro_34

Synth rack_34:
    Osc as lead /(220.0 + 34) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_34
    Filter as lp /(1000.0 + 34 * 10.0):
        Feeds: mix
        Feeds when fill_34: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_34 | label=title_34:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_34

Kit kit_34:
    for i in 0..4:
        Sampler | file="kit/34/{i}.wav"

