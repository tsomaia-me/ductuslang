state setpoint_17(0.5)
state phase_17(0)
state alarm_17(false)
state manual_17(false)
state pressures_17([]): f32[..10]
stream reading_17(0.0)
channel[16] fault_17(0)
state demand_17 = setpoint_17 * 0.9
state error_17 = reading_17 - setpoint_17
state lowest_17 = for x in pressures_17 into low from 100.0: min(low, x)
state trend_17 = reading_17.past(1, 0.0) - reading_17.past(2, 0.0)
state mode_17 = if manual_17 then Mode::Manual else Mode::Auto
state gainset_17 = match mode_17:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_17([]) = (history_17.past(1) + [phase_17])[^4..]
stream faults_17 = fault_17 + 1

let ratios_17 = [0.1, 0.25, 0.5, 0.75]
let limits_17 = ratios_17 + [1.0]
let tail_17 = limits_17[2..]
let tag_17 = "plant 17: {tail_17.size}"
let rated_17 = [2kpa, 500pa]
let heavy_17 = if rated_17[0] > 1kpa then 0.5 else 0.25

fn tier_17(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_17(x): 10 ** (x / 20)
fn depth_17(n): if n < 1 then 0 else 1 + depth_17(n - 1)
fn bounded_17(x): clamp(x, 0.0, 1.0)

pattern Bank_17(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_17(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_17 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_17 * 0.01)
    Controller as loop /(demand_17) | gain=gainset_17:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_17(error_17 + trend_17)) | gain=ratio_17(-6)
    for i in 0..4:
        Valve/(ratios_17[i])
    for i, r in tail_17:
        Valve/(r * 0.5) when alarm_17
    Loop_17/(setpoint_17) | gain=heavy_17
    when alarm_17:
        Valve/0.9
    else:
        Valve/(faults_17 * 0.01)
    when:
        phase_17 is 0: Valve/0.6
        phase_17 is 1: Valve/0.7
        else: Valve/(history_17[0] * 0.1)

Plant trim_17:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_17: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_17 manifold_17 /0
Bank_17 header_17 /(tier_17(17) * 0.001)

Plant spare_17 | mode=Off:
    Valve/(depth_17(3) * 0.1)

