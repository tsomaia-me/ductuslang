#### wire-forms (ok)
Scene dusk:
    Triggers: night
    Dims | depth=0.5: stage.wash
    Dims as soften | depth=0.4: stage.wash
    Dims/0.5: stage.wash
    Dims' as x /0.5 when a | depth=to.level: stage.wash
    Triggers when looping: dusk
    Triggers: [night, dawn, noon][look]
    Triggers: if flash_on then flash else dusk
    Triggers: match look:
        0: night
        else: dawn
    Triggers: lets[0].a
    Triggers: pick(a, b)
    Triggers: lib::scene
