state setpoint_05(0.5)
state phase_05(0)
state alarm_05(false)
state manual_05(false)
state pressures_05([]): f32[..10]
stream reading_05(0.0)
channel[16] fault_05(0)
state demand_05 = setpoint_05 * 0.9
state error_05 = reading_05 - setpoint_05
state lowest_05 = for x in pressures_05 into low from 100.0: min(low, x)
state trend_05 = reading_05.past(1, 0.0) - reading_05.past(2, 0.0)
state mode_05 = if manual_05 then Mode::Manual else Mode::Auto
state gainset_05 = match mode_05:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_05([]) = (history_05.past(1) + [phase_05])[^4..]
stream faults_05 = fault_05 + 1

let ratios_05 = [0.1, 0.25, 0.5, 0.75]
let limits_05 = ratios_05 + [1.0]
let tail_05 = limits_05[2..]
let tag_05 = "plant 05: {tail_05.size}"
let rated_05 = [2kpa, 500pa]
let heavy_05 = if rated_05[0] > 1kpa then 0.5 else 0.25

fn tier_05(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_05(x): 10 ** (x / 20)
fn depth_05(n): if n < 1 then 0 else 1 + depth_05(n - 1)
fn bounded_05(x): clamp(x, 0.0, 1.0)

pattern Bank_05(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_05(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_05 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_05 * 0.01)
    Controller as loop /(demand_05) | gain=gainset_05:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_05(error_05 + trend_05)) | gain=ratio_05(-6)
    for i in 0..4:
        Valve/(ratios_05[i])
    for i, r in tail_05:
        Valve/(r * 0.5) when alarm_05
    Loop_05/(setpoint_05) | gain=heavy_05
    when alarm_05:
        Valve/0.9
    else:
        Valve/(faults_05 * 0.01)
    when:
        phase_05 is 0: Valve/0.6
        phase_05 is 1: Valve/0.7
        else: Valve/(history_05[0] * 0.1)

Plant trim_05:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_05: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_05 manifold_05 /0
Bank_05 header_05 /(tier_05(05) * 0.001)

Plant spare_05 | mode=Off:
    Valve/(depth_05(3) * 0.1)

