state section_28(0)
state fill_28(false)
state cutoff_28(0.5)
state drive_28(0.25)
state held_28([]): i32[..12]
stream pulse_28(0)
channel[8] hits_28(0)
state swing_28 = cutoff_28 * 0.8
state bright_28 = if fill_28 then swing_28 else cutoff_28.past(1, 0.5)
stream beat_28 = pulse_28 + hits_28
state last_28 = section_28.past(1, -1)
state recent_28([]) = (recent_28.past(1) + [section_28])[^8..]
state peak_28 = for x in recent_28 into top from 0: max(top, x)
state played_28 = held_28 + [last_28]
state rising_28 = for i in 1..held_28.size into n from 0: if held_28[i] > held_28[i - 1] then n + 1 else n
state mood_28 = match section_28 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_28 = match fill_28:
    true: Wave::Saw
    false: Wave::Sine

let scale_28 = [0, 2, 4, 5, 7, 9, 11]
let chords_28 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_28 = 36 + 28 % 12
let span_28 = scale_28 + [12, 14, 16]
let upper_28 = span_28[3..8]
let lower_28 = span_28[..3]
let label_28 = "part 28"
let title_28 = "{label_28} in {root_28}"
let lengths_28 = [1bars, 2, 0.5bars]

fn degree_28(i): root_28 + scale_28[i % 7] + 12 * (i div 7)
fn fib_28(n): if n < 2 then n else fib_28(n - 1) + fib_28(n - 2)
fn level_28(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_28(i, shift = 0):
    let base = chords_28[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_28(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_28 = [fib_28(3), fib_28(4), fib_28(5), fib_28(6)]
let total_28 = for s in steps_28 into sum from 0: sum + s
let ladder_28 = for i in 0..6 into kept from []: kept + [degree_28(i)]
let voiced_28 = chord_28(28, 12)

pattern Arp_28(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_28(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_28

pattern Stab_28(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_28 | gain=0.9:
    Note/(root_28) Note/(root_28 + 4) Note/(root_28 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_28(1)) Note as top /(degree_28(3)) Note'/(degree_28(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_28)
    (Note' as mark /61 when fill_28 | velocity=0.5)
    Note/(section_28 + 1)
    Note'/62 | velocity=level_28(drive_28) brightness=bright_28
               length=2bars
    Note/(peak_28 + root_28) | length=lengths_28[0]
    Arp_28/(root_28) | steps=3
    Arp_28/(root_28 + 12) | gap=gap_28(28)
    Plays | transpose=5: verse_28
    Starts: [verse_28, chorus_28][section_28]

Clip verse_28:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_28
    for i in 0..8:
        Note/(degree_28(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_28:
        Note/(root_28 + p) | brightness=0.1 * i
    Voice_28 as low /(root_28)
    Voice_28/(root_28 + 7) | steps=2
    Stab_28/(voiced_28[0]) | loud
    Plays: chorus_28

Clip chorus_28 | gain=verse_28.gain * 1.2:
    Note/72 | velocity=verse_28.hook.velocity
    for c in chords_28:
        [Note/(root_28 + c[0]) Note/(root_28 + c[1]) Note/(root_28 + c[2])]
    when fill_28:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_28 is 0: Note/77
        section_28 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_28[i])]
    Plays as back | transpose=-2: verse_28
    Plays: bridge_28
    Plays | gain=to.hook.velocity: verse_28

Clip bridge_28 | level=mood_28:
    for i in 0..total_28:
        Note/(root_28 + i % 12) | velocity=0.5 length=lengths_28[1]
    Note/(played_28[0]) | velocity=level_28(cutoff_28, 0.2)
    Note/(rising_28 + 40)
    Plays when fill_28: intro_28

Synth rack_28:
    Osc as lead /(220.0 + 28) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_28
    Filter as lp /(1000.0 + 28 * 10.0):
        Feeds: mix
        Feeds when fill_28: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_28 | label=title_28:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_28

Kit kit_28:
    for i in 0..4:
        Sampler | file="kit/28/{i}.wav"

