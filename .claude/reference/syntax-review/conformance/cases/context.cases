#### match-in-local-let-of-for-block (ok)
let a = for x in xs into s from 0:
    let k = match x:
        0: 1
        else: 2
    let j = for y in ys into t from 0:
        t + y
    s + k + j
#### for-block-in-pattern-let-and-cell (ok)
pattern P(xs):
    let a = for x in xs into s from 0:
        s + x
    state c = for x in xs into s from 0:
        s + x
    Lamp/a
#### match-destination-with-gate-and-attrs (ok) [tree]
Scene dusk:
    Triggers as t when on_air | gain=1: match look:
        0: night
        else: dawn
#### slash-division-in-gate (ok) [sexpr]
Rig r:
    Lamp when a / b > 1
    Lamp | level=a / b hue=c /2
    Lamp/x when y / 2 > 1 | level=z / 3
    for i in 0..n / 2: Lamp/i
