#### pattern-forms (ok)
pattern Arp(default root, steps = 4, gap = 4) -> (Note*):
    for i in 0..steps:
        Note/(root + i * gap)
pattern Bank(default base: f32) -> Plant:
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)
pattern Voice(default root: i32, const steps = 4) -> (Note*, Starts):
    state gain(1.0)
    let k = 2
    state g2 = gain * k
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro
pattern Drum(default out channel hit: Hit, gain: f32 = 1.0) -> Pad:
    Pad | hit => hit gain=gain
pattern Section(default root: i32, children notes: Note*, children links: Plays*) -> Clip:
    Clip | gain=0.8:
        Note/root
        notes
        Plays: intro
        links
pattern Flash(default start: f32, children groups: [Lamp+]*) -> Rig:
    Rig:
        Lamp/start
        groups
pattern Burst(children lamps: Lamp{2+}) -> ([Lamp{2+}]):
    [lamps]
pattern M(const a, cell b, state c, stream d, channel e, out f, out state g, out stream h, out channel i, default const j = 1):
    Lamp
pattern G[K, const N](xs: K[N]) -> (Lamp{3}, Lamp{..4}, Lamp{2..4}, node+, wire*, lib::Thing, [node]{2}):
    Lamp
pattern NoParams():
    Lamp
