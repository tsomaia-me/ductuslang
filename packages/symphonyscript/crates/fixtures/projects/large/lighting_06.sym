state intensity_21(0.5)
state look_21(0)
state flash_21(false)
state chase_21([true, false, false, true, false, false, true, false])
state levels_21([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_21(0)
channel[4] go_21(0)
state glow_21 = intensity_21 * 0.8
state fade_in_21 = intensity_21.past(2, 0.0)
state pace_21 = if flash_21 then 200ms else 1.5s
state dimmed_21 = for x in levels_21 into sum from 0.0: sum + x * intensity_21
stream count_21 = tick_21 + go_21
channel bursts_21 = go_21 * 2
state moved_21 = intensity_21.stepped
state step_21 = (look_21 + 1) % 8

let ramp_21 = [0.2, 0.5, 0.8]
let hues_21 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_21 = hues_21[..3]
let cool_21 = hues_21[^3..]
let palette_21 = warm_21 + cool_21
let name_21 = "rig 21"
let holds_21 = [2s, 500ms, 4]

fn bounce_21(n): if n < 1 then 0.0 else 0.1 + bounce_21(n - 1)
fn spread_21(i, width = 0.25): (i % 4) * width
fn tint_21(i):
    let base = palette_21[i % 6]
    min(1.0, base + 0.05)

pattern Chase_21(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_21(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_21(i)

pattern Flash_21(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_21:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_21)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_21
    Lamp as wash /0.7 | hue=glow_21 strobe
    Lamp as spot /(bounce_21(4)) | hue=fade_in_21
    Lamp*/0.3 when flash_21
    Lamp/(bursts_21 * 0.1) when moved_21
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_21: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_21[i]) when chase_21[i]
    for i, p in ramp_21:
        Lamp/p | hue=spread_21(i)
    Wash_21/(intensity_21) | count=4
    Flash_21/0.1
    when flash_21:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_21 is 0: Lamp/0.25
        look_21 is 1: Lamp/0.5
        else: Lamp/(dimmed_21 * 0.1)

Scene night_21 | hold=holds_21[0]:
    Cue/0
    Cue | at=step_21 fade=1s
    Triggers: [stage_21.dusk, dawn_21][look_21]

Scene dawn_21:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_21 then night_21 else stage_21.dusk

Chase_21 loop_21 /0 | again=loop_21

