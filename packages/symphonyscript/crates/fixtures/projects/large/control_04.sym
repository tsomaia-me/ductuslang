state setpoint_13(0.5)
state phase_13(0)
state alarm_13(false)
state manual_13(false)
state pressures_13([]): f32[..10]
stream reading_13(0.0)
channel[16] fault_13(0)
state demand_13 = setpoint_13 * 0.9
state error_13 = reading_13 - setpoint_13
state lowest_13 = for x in pressures_13 into low from 100.0: min(low, x)
state trend_13 = reading_13.past(1, 0.0) - reading_13.past(2, 0.0)
state mode_13 = if manual_13 then Mode::Manual else Mode::Auto
state gainset_13 = match mode_13:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_13([]) = (history_13.past(1) + [phase_13])[^4..]
stream faults_13 = fault_13 + 1

let ratios_13 = [0.1, 0.25, 0.5, 0.75]
let limits_13 = ratios_13 + [1.0]
let tail_13 = limits_13[2..]
let tag_13 = "plant 13: {tail_13.size}"
let rated_13 = [2kpa, 500pa]
let heavy_13 = if rated_13[0] > 1kpa then 0.5 else 0.25

fn tier_13(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_13(x): 10 ** (x / 20)
fn depth_13(n): if n < 1 then 0 else 1 + depth_13(n - 1)
fn bounded_13(x): clamp(x, 0.0, 1.0)

pattern Bank_13(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_13(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_13 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_13 * 0.01)
    Controller as loop /(demand_13) | gain=gainset_13:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_13(error_13 + trend_13)) | gain=ratio_13(-6)
    for i in 0..4:
        Valve/(ratios_13[i])
    for i, r in tail_13:
        Valve/(r * 0.5) when alarm_13
    Loop_13/(setpoint_13) | gain=heavy_13
    when alarm_13:
        Valve/0.9
    else:
        Valve/(faults_13 * 0.01)
    when:
        phase_13 is 0: Valve/0.6
        phase_13 is 1: Valve/0.7
        else: Valve/(history_13[0] * 0.1)

Plant trim_13:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_13: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_13 manifold_13 /0
Bank_13 header_13 /(tier_13(13) * 0.001)

Plant spare_13 | mode=Off:
    Valve/(depth_13(3) * 0.1)

