state intensity_29(0.5)
state look_29(0)
state flash_29(false)
state chase_29([true, false, false, true, false, false, true, false])
state levels_29([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_29(0)
channel[4] go_29(0)
state glow_29 = intensity_29 * 0.8
state fade_in_29 = intensity_29.past(2, 0.0)
state pace_29 = if flash_29 then 200ms else 1.5s
state dimmed_29 = for x in levels_29 into sum from 0.0: sum + x * intensity_29
stream count_29 = tick_29 + go_29
channel bursts_29 = go_29 * 2
state moved_29 = intensity_29.stepped
state step_29 = (look_29 + 1) % 8

let ramp_29 = [0.2, 0.5, 0.8]
let hues_29 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_29 = hues_29[..3]
let cool_29 = hues_29[^3..]
let palette_29 = warm_29 + cool_29
let name_29 = "rig 29"
let holds_29 = [2s, 500ms, 4]

fn bounce_29(n): if n < 1 then 0.0 else 0.1 + bounce_29(n - 1)
fn spread_29(i, width = 0.25): (i % 4) * width
fn tint_29(i):
    let base = palette_29[i % 6]
    min(1.0, base + 0.05)

pattern Chase_29(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_29(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_29(i)

pattern Flash_29(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_29:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_29)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_29
    Lamp as wash /0.7 | hue=glow_29 strobe
    Lamp as spot /(bounce_29(4)) | hue=fade_in_29
    Lamp*/0.3 when flash_29
    Lamp/(bursts_29 * 0.1) when moved_29
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_29: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_29[i]) when chase_29[i]
    for i, p in ramp_29:
        Lamp/p | hue=spread_29(i)
    Wash_29/(intensity_29) | count=4
    Flash_29/0.1
    when flash_29:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_29 is 0: Lamp/0.25
        look_29 is 1: Lamp/0.5
        else: Lamp/(dimmed_29 * 0.1)

Scene night_29 | hold=holds_29[0]:
    Cue/0
    Cue | at=step_29 fade=1s
    Triggers: [stage_29.dusk, dawn_29][look_29]

Scene dawn_29:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_29 then night_29 else stage_29.dusk

Chase_29 loop_29 /0 | again=loop_29

