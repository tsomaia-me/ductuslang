state section_22(0)
state fill_22(false)
state cutoff_22(0.5)
state drive_22(0.25)
state held_22([]): i32[..12]
stream pulse_22(0)
channel[8] hits_22(0)
state swing_22 = cutoff_22 * 0.8
state bright_22 = if fill_22 then swing_22 else cutoff_22.past(1, 0.5)
stream beat_22 = pulse_22 + hits_22
state last_22 = section_22.past(1, -1)
state recent_22([]) = (recent_22.past(1) + [section_22])[^8..]
state peak_22 = for x in recent_22 into top from 0: max(top, x)
state played_22 = held_22 + [last_22]
state rising_22 = for i in 1..held_22.size into n from 0: if held_22[i] > held_22[i - 1] then n + 1 else n
state mood_22 = match section_22 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_22 = match fill_22:
    true: Wave::Saw
    false: Wave::Sine

let scale_22 = [0, 2, 4, 5, 7, 9, 11]
let chords_22 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_22 = 36 + 22 % 12
let span_22 = scale_22 + [12, 14, 16]
let upper_22 = span_22[3..8]
let lower_22 = span_22[..3]
let label_22 = "part 22"
let title_22 = "{label_22} in {root_22}"
let lengths_22 = [1bars, 2, 0.5bars]

fn degree_22(i): root_22 + scale_22[i % 7] + 12 * (i div 7)
fn fib_22(n): if n < 2 then n else fib_22(n - 1) + fib_22(n - 2)
fn level_22(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_22(i, shift = 0):
    let base = chords_22[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_22(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_22 = [fib_22(3), fib_22(4), fib_22(5), fib_22(6)]
let total_22 = for s in steps_22 into sum from 0: sum + s
let ladder_22 = for i in 0..6 into kept from []: kept + [degree_22(i)]
let voiced_22 = chord_22(22, 12)

pattern Arp_22(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_22(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_22

pattern Stab_22(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_22 | gain=0.9:
    Note/(root_22) Note/(root_22 + 4) Note/(root_22 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_22(1)) Note as top /(degree_22(3)) Note'/(degree_22(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_22)
    (Note' as mark /61 when fill_22 | velocity=0.5)
    Note/(section_22 + 1)
    Note'/62 | velocity=level_22(drive_22) brightness=bright_22
               length=2bars
    Note/(peak_22 + root_22) | length=lengths_22[0]
    Arp_22/(root_22) | steps=3
    Arp_22/(root_22 + 12) | gap=gap_22(22)
    Plays | transpose=5: verse_22
    Starts: [verse_22, chorus_22][section_22]

Clip verse_22:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_22
    for i in 0..8:
        Note/(degree_22(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_22:
        Note/(root_22 + p) | brightness=0.1 * i
    Voice_22 as low /(root_22)
    Voice_22/(root_22 + 7) | steps=2
    Stab_22/(voiced_22[0]) | loud
    Plays: chorus_22

Clip chorus_22 | gain=verse_22.gain * 1.2:
    Note/72 | velocity=verse_22.hook.velocity
    for c in chords_22:
        [Note/(root_22 + c[0]) Note/(root_22 + c[1]) Note/(root_22 + c[2])]
    when fill_22:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_22 is 0: Note/77
        section_22 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_22[i])]
    Plays as back | transpose=-2: verse_22
    Plays: bridge_22
    Plays | gain=to.hook.velocity: verse_22

Clip bridge_22 | level=mood_22:
    for i in 0..total_22:
        Note/(root_22 + i % 12) | velocity=0.5 length=lengths_22[1]
    Note/(played_22[0]) | velocity=level_22(cutoff_22, 0.2)
    Note/(rising_22 + 40)
    Plays when fill_22: intro_22

Synth rack_22:
    Osc as lead /(220.0 + 22) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_22
    Filter as lp /(1000.0 + 22 * 10.0):
        Feeds: mix
        Feeds when fill_22: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_22 | label=title_22:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_22

Kit kit_22:
    for i in 0..4:
        Sampler | file="kit/22/{i}.wav"

