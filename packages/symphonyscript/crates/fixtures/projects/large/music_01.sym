state section_01(0)
state fill_01(false)
state cutoff_01(0.5)
state drive_01(0.25)
state held_01([]): i32[..12]
stream pulse_01(0)
channel[8] hits_01(0)
state swing_01 = cutoff_01 * 0.8
state bright_01 = if fill_01 then swing_01 else cutoff_01.past(1, 0.5)
stream beat_01 = pulse_01 + hits_01
state last_01 = section_01.past(1, -1)
state recent_01([]) = (recent_01.past(1) + [section_01])[^8..]
state peak_01 = for x in recent_01 into top from 0: max(top, x)
state played_01 = held_01 + [last_01]
state rising_01 = for i in 1..held_01.size into n from 0: if held_01[i] > held_01[i - 1] then n + 1 else n
state mood_01 = match section_01 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_01 = match fill_01:
    true: Wave::Saw
    false: Wave::Sine

let scale_01 = [0, 2, 4, 5, 7, 9, 11]
let chords_01 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_01 = 36 + 01 % 12
let span_01 = scale_01 + [12, 14, 16]
let upper_01 = span_01[3..8]
let lower_01 = span_01[..3]
let label_01 = "part 01"
let title_01 = "{label_01} in {root_01}"
let lengths_01 = [1bars, 2, 0.5bars]

fn degree_01(i): root_01 + scale_01[i % 7] + 12 * (i div 7)
fn fib_01(n): if n < 2 then n else fib_01(n - 1) + fib_01(n - 2)
fn level_01(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_01(i, shift = 0):
    let base = chords_01[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_01(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_01 = [fib_01(3), fib_01(4), fib_01(5), fib_01(6)]
let total_01 = for s in steps_01 into sum from 0: sum + s
let ladder_01 = for i in 0..6 into kept from []: kept + [degree_01(i)]
let voiced_01 = chord_01(01, 12)

pattern Arp_01(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_01(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_01

pattern Stab_01(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_01 | gain=0.9:
    Note/(root_01) Note/(root_01 + 4) Note/(root_01 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_01(1)) Note as top /(degree_01(3)) Note'/(degree_01(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_01)
    (Note' as mark /61 when fill_01 | velocity=0.5)
    Note/(section_01 + 1)
    Note'/62 | velocity=level_01(drive_01) brightness=bright_01
               length=2bars
    Note/(peak_01 + root_01) | length=lengths_01[0]
    Arp_01/(root_01) | steps=3
    Arp_01/(root_01 + 12) | gap=gap_01(01)
    Plays | transpose=5: verse_01
    Starts: [verse_01, chorus_01][section_01]

Clip verse_01:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_01
    for i in 0..8:
        Note/(degree_01(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_01:
        Note/(root_01 + p) | brightness=0.1 * i
    Voice_01 as low /(root_01)
    Voice_01/(root_01 + 7) | steps=2
    Stab_01/(voiced_01[0]) | loud
    Plays: chorus_01

Clip chorus_01 | gain=verse_01.gain * 1.2:
    Note/72 | velocity=verse_01.hook.velocity
    for c in chords_01:
        [Note/(root_01 + c[0]) Note/(root_01 + c[1]) Note/(root_01 + c[2])]
    when fill_01:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_01 is 0: Note/77
        section_01 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_01[i])]
    Plays as back | transpose=-2: verse_01
    Plays: bridge_01
    Plays | gain=to.hook.velocity: verse_01

Clip bridge_01 | level=mood_01:
    for i in 0..total_01:
        Note/(root_01 + i % 12) | velocity=0.5 length=lengths_01[1]
    Note/(played_01[0]) | velocity=level_01(cutoff_01, 0.2)
    Note/(rising_01 + 40)
    Plays when fill_01: intro_01

Synth rack_01:
    Osc as lead /(220.0 + 01) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_01
    Filter as lp /(1000.0 + 01 * 10.0):
        Feeds: mix
        Feeds when fill_01: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_01 | label=title_01:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_01

Kit kit_01:
    for i in 0..4:
        Sampler | file="kit/01/{i}.wav"

