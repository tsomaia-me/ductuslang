#!/bin/sh
file=${1##*/}
prefix=${file#pre}
escaped=\#not
echo a; # comment after semicolon
echo $'it\'s # still a string'
case "$1" in
  a#b) echo hash ;; # arm note
  *) echo other ;;
esac
printf '%s\n' "${#file}" # length of file
echo "line one \
# not a comment, inside the string"
echo `echo '#'` # backticks
echo a\ #b
echo next
echo a\;#b
echo a\|#b c
echo a\	#b
echo ${x:-a #b}
echo $(( x << 2 )) # shift
(( y = x << 1 )) # shift again
echo "$(echo " #x")" # substitution
# trailing
echo $$'a\' #pid
