state setpoint_33(0.5)
state phase_33(0)
state alarm_33(false)
state manual_33(false)
state pressures_33([]): f32[..10]
stream reading_33(0.0)
channel[16] fault_33(0)
state demand_33 = setpoint_33 * 0.9
state error_33 = reading_33 - setpoint_33
state lowest_33 = for x in pressures_33 into low from 100.0: min(low, x)
state trend_33 = reading_33.past(1, 0.0) - reading_33.past(2, 0.0)
state mode_33 = if manual_33 then Mode::Manual else Mode::Auto
state gainset_33 = match mode_33:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_33([]) = (history_33.past(1) + [phase_33])[^4..]
stream faults_33 = fault_33 + 1

let ratios_33 = [0.1, 0.25, 0.5, 0.75]
let limits_33 = ratios_33 + [1.0]
let tail_33 = limits_33[2..]
let tag_33 = "plant 33: {tail_33.size}"
let rated_33 = [2kpa, 500pa]
let heavy_33 = if rated_33[0] > 1kpa then 0.5 else 0.25

fn tier_33(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_33(x): 10 ** (x / 20)
fn depth_33(n): if n < 1 then 0 else 1 + depth_33(n - 1)
fn bounded_33(x): clamp(x, 0.0, 1.0)

pattern Bank_33(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_33(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_33 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_33 * 0.01)
    Controller as loop /(demand_33) | gain=gainset_33:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_33(error_33 + trend_33)) | gain=ratio_33(-6)
    for i in 0..4:
        Valve/(ratios_33[i])
    for i, r in tail_33:
        Valve/(r * 0.5) when alarm_33
    Loop_33/(setpoint_33) | gain=heavy_33
    when alarm_33:
        Valve/0.9
    else:
        Valve/(faults_33 * 0.01)
    when:
        phase_33 is 0: Valve/0.6
        phase_33 is 1: Valve/0.7
        else: Valve/(history_33[0] * 0.1)

Plant trim_33:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_33: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_33 manifold_33 /0
Bank_33 header_33 /(tier_33(33) * 0.001)

Plant spare_33 | mode=Off:
    Valve/(depth_33(3) * 0.1)

