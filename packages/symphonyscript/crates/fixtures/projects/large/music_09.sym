state section_25(0)
state fill_25(false)
state cutoff_25(0.5)
state drive_25(0.25)
state held_25([]): i32[..12]
stream pulse_25(0)
channel[8] hits_25(0)
state swing_25 = cutoff_25 * 0.8
state bright_25 = if fill_25 then swing_25 else cutoff_25.past(1, 0.5)
stream beat_25 = pulse_25 + hits_25
state last_25 = section_25.past(1, -1)
state recent_25([]) = (recent_25.past(1) + [section_25])[^8..]
state peak_25 = for x in recent_25 into top from 0: max(top, x)
state played_25 = held_25 + [last_25]
state rising_25 = for i in 1..held_25.size into n from 0: if held_25[i] > held_25[i - 1] then n + 1 else n
state mood_25 = match section_25 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_25 = match fill_25:
    true: Wave::Saw
    false: Wave::Sine

let scale_25 = [0, 2, 4, 5, 7, 9, 11]
let chords_25 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_25 = 36 + 25 % 12
let span_25 = scale_25 + [12, 14, 16]
let upper_25 = span_25[3..8]
let lower_25 = span_25[..3]
let label_25 = "part 25"
let title_25 = "{label_25} in {root_25}"
let lengths_25 = [1bars, 2, 0.5bars]

fn degree_25(i): root_25 + scale_25[i % 7] + 12 * (i div 7)
fn fib_25(n): if n < 2 then n else fib_25(n - 1) + fib_25(n - 2)
fn level_25(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_25(i, shift = 0):
    let base = chords_25[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_25(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_25 = [fib_25(3), fib_25(4), fib_25(5), fib_25(6)]
let total_25 = for s in steps_25 into sum from 0: sum + s
let ladder_25 = for i in 0..6 into kept from []: kept + [degree_25(i)]
let voiced_25 = chord_25(25, 12)

pattern Arp_25(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_25(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_25

pattern Stab_25(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_25 | gain=0.9:
    Note/(root_25) Note/(root_25 + 4) Note/(root_25 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_25(1)) Note as top /(degree_25(3)) Note'/(degree_25(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_25)
    (Note' as mark /61 when fill_25 | velocity=0.5)
    Note/(section_25 + 1)
    Note'/62 | velocity=level_25(drive_25) brightness=bright_25
               length=2bars
    Note/(peak_25 + root_25) | length=lengths_25[0]
    Arp_25/(root_25) | steps=3
    Arp_25/(root_25 + 12) | gap=gap_25(25)
    Plays | transpose=5: verse_25
    Starts: [verse_25, chorus_25][section_25]

Clip verse_25:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_25
    for i in 0..8:
        Note/(degree_25(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_25:
        Note/(root_25 + p) | brightness=0.1 * i
    Voice_25 as low /(root_25)
    Voice_25/(root_25 + 7) | steps=2
    Stab_25/(voiced_25[0]) | loud
    Plays: chorus_25

Clip chorus_25 | gain=verse_25.gain * 1.2:
    Note/72 | velocity=verse_25.hook.velocity
    for c in chords_25:
        [Note/(root_25 + c[0]) Note/(root_25 + c[1]) Note/(root_25 + c[2])]
    when fill_25:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_25 is 0: Note/77
        section_25 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_25[i])]
    Plays as back | transpose=-2: verse_25
    Plays: bridge_25
    Plays | gain=to.hook.velocity: verse_25

Clip bridge_25 | level=mood_25:
    for i in 0..total_25:
        Note/(root_25 + i % 12) | velocity=0.5 length=lengths_25[1]
    Note/(played_25[0]) | velocity=level_25(cutoff_25, 0.2)
    Note/(rising_25 + 40)
    Plays when fill_25: intro_25

Synth rack_25:
    Osc as lead /(220.0 + 25) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_25
    Filter as lp /(1000.0 + 25 * 10.0):
        Feeds: mix
        Feeds when fill_25: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_25 | label=title_25:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_25

Kit kit_25:
    for i in 0..4:
        Sampler | file="kit/25/{i}.wav"

