state intensity_33(0.5)
state look_33(0)
state flash_33(false)
state chase_33([true, false, false, true, false, false, true, false])
state levels_33([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_33(0)
channel[4] go_33(0)
state glow_33 = intensity_33 * 0.8
state fade_in_33 = intensity_33.past(2, 0.0)
state pace_33 = if flash_33 then 200ms else 1.5s
state dimmed_33 = for x in levels_33 into sum from 0.0: sum + x * intensity_33
stream count_33 = tick_33 + go_33
channel bursts_33 = go_33 * 2
state moved_33 = intensity_33.stepped
state step_33 = (look_33 + 1) % 8

let ramp_33 = [0.2, 0.5, 0.8]
let hues_33 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_33 = hues_33[..3]
let cool_33 = hues_33[^3..]
let palette_33 = warm_33 + cool_33
let name_33 = "rig 33"
let holds_33 = [2s, 500ms, 4]

fn bounce_33(n): if n < 1 then 0.0 else 0.1 + bounce_33(n - 1)
fn spread_33(i, width = 0.25): (i % 4) * width
fn tint_33(i):
    let base = palette_33[i % 6]
    min(1.0, base + 0.05)

pattern Chase_33(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_33(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_33(i)

pattern Flash_33(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_33:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_33)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_33
    Lamp as wash /0.7 | hue=glow_33 strobe
    Lamp as spot /(bounce_33(4)) | hue=fade_in_33
    Lamp*/0.3 when flash_33
    Lamp/(bursts_33 * 0.1) when moved_33
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_33: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_33[i]) when chase_33[i]
    for i, p in ramp_33:
        Lamp/p | hue=spread_33(i)
    Wash_33/(intensity_33) | count=4
    Flash_33/0.1
    when flash_33:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_33 is 0: Lamp/0.25
        look_33 is 1: Lamp/0.5
        else: Lamp/(dimmed_33 * 0.1)

Scene night_33 | hold=holds_33[0]:
    Cue/0
    Cue | at=step_33 fade=1s
    Triggers: [stage_33.dusk, dawn_33][look_33]

Scene dawn_33:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_33 then night_33 else stage_33.dusk

Chase_33 loop_33 /0 | again=loop_33

