state section_04(0)
state fill_04(false)
state cutoff_04(0.5)
state drive_04(0.25)
state held_04([]): i32[..12]
stream pulse_04(0)
channel[8] hits_04(0)
state swing_04 = cutoff_04 * 0.8
state bright_04 = if fill_04 then swing_04 else cutoff_04.past(1, 0.5)
stream beat_04 = pulse_04 + hits_04
state last_04 = section_04.past(1, -1)
state recent_04([]) = (recent_04.past(1) + [section_04])[^8..]
state peak_04 = for x in recent_04 into top from 0: max(top, x)
state played_04 = held_04 + [last_04]
state rising_04 = for i in 1..held_04.size into n from 0: if held_04[i] > held_04[i - 1] then n + 1 else n
state mood_04 = match section_04 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_04 = match fill_04:
    true: Wave::Saw
    false: Wave::Sine

let scale_04 = [0, 2, 4, 5, 7, 9, 11]
let chords_04 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_04 = 36 + 04 % 12
let span_04 = scale_04 + [12, 14, 16]
let upper_04 = span_04[3..8]
let lower_04 = span_04[..3]
let label_04 = "part 04"
let title_04 = "{label_04} in {root_04}"
let lengths_04 = [1bars, 2, 0.5bars]

fn degree_04(i): root_04 + scale_04[i % 7] + 12 * (i div 7)
fn fib_04(n): if n < 2 then n else fib_04(n - 1) + fib_04(n - 2)
fn level_04(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_04(i, shift = 0):
    let base = chords_04[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_04(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_04 = [fib_04(3), fib_04(4), fib_04(5), fib_04(6)]
let total_04 = for s in steps_04 into sum from 0: sum + s
let ladder_04 = for i in 0..6 into kept from []: kept + [degree_04(i)]
let voiced_04 = chord_04(04, 12)

pattern Arp_04(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_04(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_04

pattern Stab_04(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_04 | gain=0.9:
    Note/(root_04) Note/(root_04 + 4) Note/(root_04 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_04(1)) Note as top /(degree_04(3)) Note'/(degree_04(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_04)
    (Note' as mark /61 when fill_04 | velocity=0.5)
    Note/(section_04 + 1)
    Note'/62 | velocity=level_04(drive_04) brightness=bright_04
               length=2bars
    Note/(peak_04 + root_04) | length=lengths_04[0]
    Arp_04/(root_04) | steps=3
    Arp_04/(root_04 + 12) | gap=gap_04(04)
    Plays | transpose=5: verse_04
    Starts: [verse_04, chorus_04][section_04]

Clip verse_04:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_04
    for i in 0..8:
        Note/(degree_04(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_04:
        Note/(root_04 + p) | brightness=0.1 * i
    Voice_04 as low /(root_04)
    Voice_04/(root_04 + 7) | steps=2
    Stab_04/(voiced_04[0]) | loud
    Plays: chorus_04

Clip chorus_04 | gain=verse_04.gain * 1.2:
    Note/72 | velocity=verse_04.hook.velocity
    for c in chords_04:
        [Note/(root_04 + c[0]) Note/(root_04 + c[1]) Note/(root_04 + c[2])]
    when fill_04:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_04 is 0: Note/77
        section_04 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_04[i])]
    Plays as back | transpose=-2: verse_04
    Plays: bridge_04
    Plays | gain=to.hook.velocity: verse_04

Clip bridge_04 | level=mood_04:
    for i in 0..total_04:
        Note/(root_04 + i % 12) | velocity=0.5 length=lengths_04[1]
    Note/(played_04[0]) | velocity=level_04(cutoff_04, 0.2)
    Note/(rising_04 + 40)
    Plays when fill_04: intro_04

Synth rack_04:
    Osc as lead /(220.0 + 04) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_04
    Filter as lp /(1000.0 + 04 * 10.0):
        Feeds: mix
        Feeds when fill_04: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_04 | label=title_04:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_04

Kit kit_04:
    for i in 0..4:
        Sampler | file="kit/04/{i}.wav"

