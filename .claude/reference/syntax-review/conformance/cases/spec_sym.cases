#### §6.3 1 sym L857
fn ratio(x): 10 ** (x / 20)

fn tier(rank: i32, base: i32 = 100) -> i32:
    let cycles: i32 = rank div 4
    base + [0, 5, 15, 40][rank % 4] + 50 * cycles
#### §6.3 2 sym L867
fn fib(n): if n < 2 then n else fib(n - 1) + fib(n - 2)

let lengths = [fib(3), fib(4), fib(5), fib(6)]
