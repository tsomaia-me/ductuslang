state intensity_13(0.5)
state look_13(0)
state flash_13(false)
state chase_13([true, false, false, true, false, false, true, false])
state levels_13([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_13(0)
channel[4] go_13(0)
state glow_13 = intensity_13 * 0.8
state fade_in_13 = intensity_13.past(2, 0.0)
state pace_13 = if flash_13 then 200ms else 1.5s
state dimmed_13 = for x in levels_13 into sum from 0.0: sum + x * intensity_13
stream count_13 = tick_13 + go_13
channel bursts_13 = go_13 * 2
state moved_13 = intensity_13.stepped
state step_13 = (look_13 + 1) % 8

let ramp_13 = [0.2, 0.5, 0.8]
let hues_13 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_13 = hues_13[..3]
let cool_13 = hues_13[^3..]
let palette_13 = warm_13 + cool_13
let name_13 = "rig 13"
let holds_13 = [2s, 500ms, 4]

fn bounce_13(n): if n < 1 then 0.0 else 0.1 + bounce_13(n - 1)
fn spread_13(i, width = 0.25): (i % 4) * width
fn tint_13(i):
    let base = palette_13[i % 6]
    min(1.0, base + 0.05)

pattern Chase_13(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_13(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_13(i)

pattern Flash_13(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_13:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_13)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_13
    Lamp as wash /0.7 | hue=glow_13 strobe
    Lamp as spot /(bounce_13(4)) | hue=fade_in_13
    Lamp*/0.3 when flash_13
    Lamp/(bursts_13 * 0.1) when moved_13
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_13: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_13[i]) when chase_13[i]
    for i, p in ramp_13:
        Lamp/p | hue=spread_13(i)
    Wash_13/(intensity_13) | count=4
    Flash_13/0.1
    when flash_13:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_13 is 0: Lamp/0.25
        look_13 is 1: Lamp/0.5
        else: Lamp/(dimmed_13 * 0.1)

Scene night_13 | hold=holds_13[0]:
    Cue/0
    Cue | at=step_13 fade=1s
    Triggers: [stage_13.dusk, dawn_13][look_13]

Scene dawn_13:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_13 then night_13 else stage_13.dusk

Chase_13 loop_13 /0 | again=loop_13

