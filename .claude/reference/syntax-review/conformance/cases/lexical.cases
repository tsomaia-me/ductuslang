state s(""): string
#### null-outside-json (error)
let a = null
#### null-as-name (error)
let null = 1
#### null-in-json (ok)
let a = json null
let b = json {"a": null}
let c = json [null, null]
#### null-in-json-paren (error)
let b = json {"a": (null)}
#### nullable-ident (ok)
let nullable = 1
let b = json {"a": nullable}
#### eqeq (error -> is)
let a = b == c
#### bangeq (error -> is not)
let a = b != c
#### eq-eq-spaced (not the token)
let a = b = = c
#### caret-in-index (ok)
let a = xs[^1]
let b = xs[^2..]
let c = xs[1..^1]
let d = xs[..^1]
let e = xs[^(n + 1)]
