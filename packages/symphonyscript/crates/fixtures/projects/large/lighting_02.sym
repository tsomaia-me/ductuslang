state intensity_05(0.5)
state look_05(0)
state flash_05(false)
state chase_05([true, false, false, true, false, false, true, false])
state levels_05([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_05(0)
channel[4] go_05(0)
state glow_05 = intensity_05 * 0.8
state fade_in_05 = intensity_05.past(2, 0.0)
state pace_05 = if flash_05 then 200ms else 1.5s
state dimmed_05 = for x in levels_05 into sum from 0.0: sum + x * intensity_05
stream count_05 = tick_05 + go_05
channel bursts_05 = go_05 * 2
state moved_05 = intensity_05.stepped
state step_05 = (look_05 + 1) % 8

let ramp_05 = [0.2, 0.5, 0.8]
let hues_05 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_05 = hues_05[..3]
let cool_05 = hues_05[^3..]
let palette_05 = warm_05 + cool_05
let name_05 = "rig 05"
let holds_05 = [2s, 500ms, 4]

fn bounce_05(n): if n < 1 then 0.0 else 0.1 + bounce_05(n - 1)
fn spread_05(i, width = 0.25): (i % 4) * width
fn tint_05(i):
    let base = palette_05[i % 6]
    min(1.0, base + 0.05)

pattern Chase_05(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_05(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_05(i)

pattern Flash_05(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_05:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_05)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_05
    Lamp as wash /0.7 | hue=glow_05 strobe
    Lamp as spot /(bounce_05(4)) | hue=fade_in_05
    Lamp*/0.3 when flash_05
    Lamp/(bursts_05 * 0.1) when moved_05
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_05: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_05[i]) when chase_05[i]
    for i, p in ramp_05:
        Lamp/p | hue=spread_05(i)
    Wash_05/(intensity_05) | count=4
    Flash_05/0.1
    when flash_05:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_05 is 0: Lamp/0.25
        look_05 is 1: Lamp/0.5
        else: Lamp/(dimmed_05 * 0.1)

Scene night_05 | hold=holds_05[0]:
    Cue/0
    Cue | at=step_05 fade=1s
    Triggers: [stage_05.dusk, dawn_05][look_05]

Scene dawn_05:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_05 then night_05 else stage_05.dusk

Chase_05 loop_05 /0 | again=loop_05

