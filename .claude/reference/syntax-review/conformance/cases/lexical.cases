let a = b ^ c
#### caret-elsewhere-prefix (error)
let a = ^1
#### caret-not-at-start-of-bound (error)
let a = xs[1 + ^1]
#### caret-twice (error)
let a = xs[^^1]
#### caret-in-paren-in-index (error)
let a = xs[(^1)]
#### caret-in-type-dim (error)
let a: i32[^1] = b
