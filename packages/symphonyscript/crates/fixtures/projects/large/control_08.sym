state setpoint_29(0.5)
state phase_29(0)
state alarm_29(false)
state manual_29(false)
state pressures_29([]): f32[..10]
stream reading_29(0.0)
channel[16] fault_29(0)
state demand_29 = setpoint_29 * 0.9
state error_29 = reading_29 - setpoint_29
state lowest_29 = for x in pressures_29 into low from 100.0: min(low, x)
state trend_29 = reading_29.past(1, 0.0) - reading_29.past(2, 0.0)
state mode_29 = if manual_29 then Mode::Manual else Mode::Auto
state gainset_29 = match mode_29:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_29([]) = (history_29.past(1) + [phase_29])[^4..]
stream faults_29 = fault_29 + 1

let ratios_29 = [0.1, 0.25, 0.5, 0.75]
let limits_29 = ratios_29 + [1.0]
let tail_29 = limits_29[2..]
let tag_29 = "plant 29: {tail_29.size}"
let rated_29 = [2kpa, 500pa]
let heavy_29 = if rated_29[0] > 1kpa then 0.5 else 0.25

fn tier_29(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_29(x): 10 ** (x / 20)
fn depth_29(n): if n < 1 then 0 else 1 + depth_29(n - 1)
fn bounded_29(x): clamp(x, 0.0, 1.0)

pattern Bank_29(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_29(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_29 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_29 * 0.01)
    Controller as loop /(demand_29) | gain=gainset_29:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_29(error_29 + trend_29)) | gain=ratio_29(-6)
    for i in 0..4:
        Valve/(ratios_29[i])
    for i, r in tail_29:
        Valve/(r * 0.5) when alarm_29
    Loop_29/(setpoint_29) | gain=heavy_29
    when alarm_29:
        Valve/0.9
    else:
        Valve/(faults_29 * 0.01)
    when:
        phase_29 is 0: Valve/0.6
        phase_29 is 1: Valve/0.7
        else: Valve/(history_29[0] * 0.1)

Plant trim_29:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_29: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_29 manifold_29 /0
Bank_29 header_29 /(tier_29(29) * 0.001)

Plant spare_29 | mode=Off:
    Valve/(depth_29(3) * 0.1)

