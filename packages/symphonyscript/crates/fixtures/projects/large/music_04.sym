state section_10(0)
state fill_10(false)
state cutoff_10(0.5)
state drive_10(0.25)
state held_10([]): i32[..12]
stream pulse_10(0)
channel[8] hits_10(0)
state swing_10 = cutoff_10 * 0.8
state bright_10 = if fill_10 then swing_10 else cutoff_10.past(1, 0.5)
stream beat_10 = pulse_10 + hits_10
state last_10 = section_10.past(1, -1)
state recent_10([]) = (recent_10.past(1) + [section_10])[^8..]
state peak_10 = for x in recent_10 into top from 0: max(top, x)
state played_10 = held_10 + [last_10]
state rising_10 = for i in 1..held_10.size into n from 0: if held_10[i] > held_10[i - 1] then n + 1 else n
state mood_10 = match section_10 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_10 = match fill_10:
    true: Wave::Saw
    false: Wave::Sine

let scale_10 = [0, 2, 4, 5, 7, 9, 11]
let chords_10 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_10 = 36 + 10 % 12
let span_10 = scale_10 + [12, 14, 16]
let upper_10 = span_10[3..8]
let lower_10 = span_10[..3]
let label_10 = "part 10"
let title_10 = "{label_10} in {root_10}"
let lengths_10 = [1bars, 2, 0.5bars]

fn degree_10(i): root_10 + scale_10[i % 7] + 12 * (i div 7)
fn fib_10(n): if n < 2 then n else fib_10(n - 1) + fib_10(n - 2)
fn level_10(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_10(i, shift = 0):
    let base = chords_10[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_10(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_10 = [fib_10(3), fib_10(4), fib_10(5), fib_10(6)]
let total_10 = for s in steps_10 into sum from 0: sum + s
let ladder_10 = for i in 0..6 into kept from []: kept + [degree_10(i)]
let voiced_10 = chord_10(10, 12)

pattern Arp_10(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_10(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_10

pattern Stab_10(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_10 | gain=0.9:
    Note/(root_10) Note/(root_10 + 4) Note/(root_10 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_10(1)) Note as top /(degree_10(3)) Note'/(degree_10(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_10)
    (Note' as mark /61 when fill_10 | velocity=0.5)
    Note/(section_10 + 1)
    Note'/62 | velocity=level_10(drive_10) brightness=bright_10
               length=2bars
    Note/(peak_10 + root_10) | length=lengths_10[0]
    Arp_10/(root_10) | steps=3
    Arp_10/(root_10 + 12) | gap=gap_10(10)
    Plays | transpose=5: verse_10
    Starts: [verse_10, chorus_10][section_10]

Clip verse_10:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_10
    for i in 0..8:
        Note/(degree_10(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_10:
        Note/(root_10 + p) | brightness=0.1 * i
    Voice_10 as low /(root_10)
    Voice_10/(root_10 + 7) | steps=2
    Stab_10/(voiced_10[0]) | loud
    Plays: chorus_10

Clip chorus_10 | gain=verse_10.gain * 1.2:
    Note/72 | velocity=verse_10.hook.velocity
    for c in chords_10:
        [Note/(root_10 + c[0]) Note/(root_10 + c[1]) Note/(root_10 + c[2])]
    when fill_10:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_10 is 0: Note/77
        section_10 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_10[i])]
    Plays as back | transpose=-2: verse_10
    Plays: bridge_10
    Plays | gain=to.hook.velocity: verse_10

Clip bridge_10 | level=mood_10:
    for i in 0..total_10:
        Note/(root_10 + i % 12) | velocity=0.5 length=lengths_10[1]
    Note/(played_10[0]) | velocity=level_10(cutoff_10, 0.2)
    Note/(rising_10 + 40)
    Plays when fill_10: intro_10

Synth rack_10:
    Osc as lead /(220.0 + 10) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_10
    Filter as lp /(1000.0 + 10 * 10.0):
        Feeds: mix
        Feeds when fill_10: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_10 | label=title_10:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_10

Kit kit_10:
    for i in 0..4:
        Sampler | file="kit/10/{i}.wav"

