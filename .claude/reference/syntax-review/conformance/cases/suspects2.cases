    state: 1,
    channel: 2
}
#### record-key-keyword-in-body-at-top
Plant boiler:
    Controller | target=(Band {
    let: 1,
    fn: 2}.low)
#### pattern-params-col0-marker
pattern P(
state s,
stream t
) -> Lamp:
    Lamp
#### pattern-params-indented (control)
pattern P(
    state s,
    stream t
) -> Lamp:
    Lamp
#### paren-placement-keyword-attr-col
Rig r:
    (Lamp | level=1
    channel=2)
#### fn-inline-match (grammar refuses)
fn f(x): match x:
    0: 1
    else: 2
#### fn-inline-for-block (grammar refuses)
fn f(xs): for x in xs into n from 0:
    n + x
#### fn-inline-for-oneline (control)
fn f(xs): for x in xs into n from 0: n + x
#### let-match (control)
let a = match x:
    0: 1
    else: 2
#### let-typed-match (control)
let a: i32 = match x:
    0: 1
    else: 2
#### nested-for-in-for-body (prose refuses)
let a = for x in xs into n from 0: for y in ys into m from n: m + y
#### for-in-if-branch (prose refuses)
let a = if c then for x in xs into n from 0: n + x else 0
#### for-in-match-arm (prose refuses)
let a = match c:
    0: for x in xs into n from 0: n + x
    else: 0
#### for-in-lambda-body (prose refuses)
let f = xs: for x in xs into n from 0: n + x
#### forblock-last-is-for (prose refuses)
let a = for x in xs into n from 0:
    for y in ys into m from n: m + y
#### for-parenthesized-everywhere (control)
let a = for x in (for y in ys into m from []: m + [y]) into n from (for z in zs into k from 0: k + z): (for w in ws into q from n: q + w)
