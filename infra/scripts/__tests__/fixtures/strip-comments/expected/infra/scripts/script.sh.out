#!/usr/bin/env bash
# shellcheck disable=SC2086
set -euo pipefail

count=${#items[@]}
last=$#
name="a # b"
single='it # stays'
word=a#b
echo "$(printf '%s' "x") # not a comment"
echo "$((1 << 2))"
for ((i = 0; i < ${#items[@]}; i++)); do
  echo "$i"
done
value=$(
  echo hi
)
cat <<EOF
# heredoc body line
echo "\$not code"
EOF
cat <<-'EOT'
	# tabbed body
	EOT
cat <<ONE; cat <<TWO
# first body
ONE
# second body
TWO
if true; then
  echo yes
fi
# shellcheck disable=SC2034
unused=1
