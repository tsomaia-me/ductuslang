state intensity_01(0.5)
state look_01(0)
state flash_01(false)
state chase_01([true, false, false, true, false, false, true, false])
state levels_01([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_01(0)
channel[4] go_01(0)
state glow_01 = intensity_01 * 0.8
state fade_in_01 = intensity_01.past(2, 0.0)
state pace_01 = if flash_01 then 200ms else 1.5s
state dimmed_01 = for x in levels_01 into sum from 0.0: sum + x * intensity_01
stream count_01 = tick_01 + go_01
channel bursts_01 = go_01 * 2
state moved_01 = intensity_01.stepped
state step_01 = (look_01 + 1) % 8

let ramp_01 = [0.2, 0.5, 0.8]
let hues_01 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_01 = hues_01[..3]
let cool_01 = hues_01[^3..]
let palette_01 = warm_01 + cool_01
let name_01 = "rig 01"
let holds_01 = [2s, 500ms, 4]

fn bounce_01(n): if n < 1 then 0.0 else 0.1 + bounce_01(n - 1)
fn spread_01(i, width = 0.25): (i % 4) * width
fn tint_01(i):
    let base = palette_01[i % 6]
    min(1.0, base + 0.05)

pattern Chase_01(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_01(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_01(i)

pattern Flash_01(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_01:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_01)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_01
    Lamp as wash /0.7 | hue=glow_01 strobe
    Lamp as spot /(bounce_01(4)) | hue=fade_in_01
    Lamp*/0.3 when flash_01
    Lamp/(bursts_01 * 0.1) when moved_01
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_01: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_01[i]) when chase_01[i]
    for i, p in ramp_01:
        Lamp/p | hue=spread_01(i)
    Wash_01/(intensity_01) | count=4
    Flash_01/0.1
    when flash_01:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_01 is 0: Lamp/0.25
        look_01 is 1: Lamp/0.5
        else: Lamp/(dimmed_01 * 0.1)

Scene night_01 | hold=holds_01[0]:
    Cue/0
    Cue | at=step_01 fade=1s
    Triggers: [stage_01.dusk, dawn_01][look_01]

Scene dawn_01:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_01 then night_01 else stage_01.dusk

Chase_01 loop_01 /0 | again=loop_01

