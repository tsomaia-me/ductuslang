#### for-from-bare-name-in-parens (ok)
let a = 1 + (for x in xs into s from start: s + x)
let b = [(for x in xs into s from start: s)]
let c = f((for x in xs into s from start: s))
let d = xs[(for x in xs into s from start: s)]
let e = "v {(for x in xs into s from start: s)}"
state g((for x in xs into s from start: s))
let h = i32((for x in xs into s from start: s))
#### for-iterable-bare-name-in-parens (ok)
