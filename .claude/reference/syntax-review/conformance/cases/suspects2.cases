#### typearg-single-name [tree]
fn f[T](b: Box[T]) -> T: b.item
#### typearg-single-generic
fn f(b: Box[Pair[i32, bool]]) -> i32: 1
#### typearg-single-optional
fn f[T](b: Box[T?]) -> i32: 1
#### typearg-single-sum
fn f(b: Box[Circle | Square]) -> i32: 1
#### typearg-single-paren
fn f(b: Box[(i32?)[..4]]) -> i32: 1
#### typearg-single-qualified
fn f(b: Box[util::Band]) -> i32: 1
#### typearg-single-map
fn f(b: Box[{str[..4]: i32}[..8]]) -> i32: 1
#### typearg-single-scalar (control)
fn f(b: Box[i32]) -> i32: 1
#### typearg-single-fn-type
fn f(b: Box[(i32) -> i32]) -> i32: 1
#### typearg-two (control)
fn f(b: Pair[Box[T], T?]) -> i32: 1
#### typearg-nested-dim-in-args
fn f(b: Pair[i32[4], Band[4]]) -> i32: 1
#### is-generic-type
state t = x is Pair[i32, bool]
#### is-name-dims (control)
state t = x is Band[4]
#### is-scalar-dims (control)
state t = x is i32[4]
#### is-not-none (control)
state t = x is not none
#### is-scalar-optional (grammar refuses)
state t = x is i32?
#### match-label-optional (grammar refuses)
state t = match x:
    i32?: 1
    else: 2
#### match-label-generic (control) [tree]
state t = match x:
    Pair[i32, bool]: 1
    Circle: 3
    none: 4
    else: 2
#### record-key-keyword-col0
let r = Config {
state: 1,
channel: 2
}
