state intensity_17(0.5)
state look_17(0)
state flash_17(false)
state chase_17([true, false, false, true, false, false, true, false])
state levels_17([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_17(0)
channel[4] go_17(0)
state glow_17 = intensity_17 * 0.8
state fade_in_17 = intensity_17.past(2, 0.0)
state pace_17 = if flash_17 then 200ms else 1.5s
state dimmed_17 = for x in levels_17 into sum from 0.0: sum + x * intensity_17
stream count_17 = tick_17 + go_17
channel bursts_17 = go_17 * 2
state moved_17 = intensity_17.stepped
state step_17 = (look_17 + 1) % 8

let ramp_17 = [0.2, 0.5, 0.8]
let hues_17 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_17 = hues_17[..3]
let cool_17 = hues_17[^3..]
let palette_17 = warm_17 + cool_17
let name_17 = "rig 17"
let holds_17 = [2s, 500ms, 4]

fn bounce_17(n): if n < 1 then 0.0 else 0.1 + bounce_17(n - 1)
fn spread_17(i, width = 0.25): (i % 4) * width
fn tint_17(i):
    let base = palette_17[i % 6]
    min(1.0, base + 0.05)

pattern Chase_17(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_17(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_17(i)

pattern Flash_17(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_17:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_17)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_17
    Lamp as wash /0.7 | hue=glow_17 strobe
    Lamp as spot /(bounce_17(4)) | hue=fade_in_17
    Lamp*/0.3 when flash_17
    Lamp/(bursts_17 * 0.1) when moved_17
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_17: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_17[i]) when chase_17[i]
    for i, p in ramp_17:
        Lamp/p | hue=spread_17(i)
    Wash_17/(intensity_17) | count=4
    Flash_17/0.1
    when flash_17:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_17 is 0: Lamp/0.25
        look_17 is 1: Lamp/0.5
        else: Lamp/(dimmed_17 * 0.1)

Scene night_17 | hold=holds_17[0]:
    Cue/0
    Cue | at=step_17 fade=1s
    Triggers: [stage_17.dusk, dawn_17][look_17]

Scene dawn_17:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_17 then night_17 else stage_17.dusk

Chase_17 loop_17 /0 | again=loop_17

