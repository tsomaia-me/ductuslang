state section_31(0)
state fill_31(false)
state cutoff_31(0.5)
state drive_31(0.25)
state held_31([]): i32[..12]
stream pulse_31(0)
channel[8] hits_31(0)
state swing_31 = cutoff_31 * 0.8
state bright_31 = if fill_31 then swing_31 else cutoff_31.past(1, 0.5)
stream beat_31 = pulse_31 + hits_31
state last_31 = section_31.past(1, -1)
state recent_31([]) = (recent_31.past(1) + [section_31])[^8..]
state peak_31 = for x in recent_31 into top from 0: max(top, x)
state played_31 = held_31 + [last_31]
state rising_31 = for i in 1..held_31.size into n from 0: if held_31[i] > held_31[i - 1] then n + 1 else n
state mood_31 = match section_31 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_31 = match fill_31:
    true: Wave::Saw
    false: Wave::Sine

let scale_31 = [0, 2, 4, 5, 7, 9, 11]
let chords_31 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_31 = 36 + 31 % 12
let span_31 = scale_31 + [12, 14, 16]
let upper_31 = span_31[3..8]
let lower_31 = span_31[..3]
let label_31 = "part 31"
let title_31 = "{label_31} in {root_31}"
let lengths_31 = [1bars, 2, 0.5bars]

fn degree_31(i): root_31 + scale_31[i % 7] + 12 * (i div 7)
fn fib_31(n): if n < 2 then n else fib_31(n - 1) + fib_31(n - 2)
fn level_31(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_31(i, shift = 0):
    let base = chords_31[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_31(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_31 = [fib_31(3), fib_31(4), fib_31(5), fib_31(6)]
let total_31 = for s in steps_31 into sum from 0: sum + s
let ladder_31 = for i in 0..6 into kept from []: kept + [degree_31(i)]
let voiced_31 = chord_31(31, 12)

pattern Arp_31(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_31(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_31

pattern Stab_31(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_31 | gain=0.9:
    Note/(root_31) Note/(root_31 + 4) Note/(root_31 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_31(1)) Note as top /(degree_31(3)) Note'/(degree_31(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_31)
    (Note' as mark /61 when fill_31 | velocity=0.5)
    Note/(section_31 + 1)
    Note'/62 | velocity=level_31(drive_31) brightness=bright_31
               length=2bars
    Note/(peak_31 + root_31) | length=lengths_31[0]
    Arp_31/(root_31) | steps=3
    Arp_31/(root_31 + 12) | gap=gap_31(31)
    Plays | transpose=5: verse_31
    Starts: [verse_31, chorus_31][section_31]

Clip verse_31:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_31
    for i in 0..8:
        Note/(degree_31(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_31:
        Note/(root_31 + p) | brightness=0.1 * i
    Voice_31 as low /(root_31)
    Voice_31/(root_31 + 7) | steps=2
    Stab_31/(voiced_31[0]) | loud
    Plays: chorus_31

Clip chorus_31 | gain=verse_31.gain * 1.2:
    Note/72 | velocity=verse_31.hook.velocity
    for c in chords_31:
        [Note/(root_31 + c[0]) Note/(root_31 + c[1]) Note/(root_31 + c[2])]
    when fill_31:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_31 is 0: Note/77
        section_31 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_31[i])]
    Plays as back | transpose=-2: verse_31
    Plays: bridge_31
    Plays | gain=to.hook.velocity: verse_31

Clip bridge_31 | level=mood_31:
    for i in 0..total_31:
        Note/(root_31 + i % 12) | velocity=0.5 length=lengths_31[1]
    Note/(played_31[0]) | velocity=level_31(cutoff_31, 0.2)
    Note/(rising_31 + 40)
    Plays when fill_31: intro_31

Synth rack_31:
    Osc as lead /(220.0 + 31) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_31
    Filter as lp /(1000.0 + 31 * 10.0):
        Feeds: mix
        Feeds when fill_31: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_31 | label=title_31:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_31

Kit kit_31:
    for i in 0..4:
        Sampler | file="kit/31/{i}.wav"

