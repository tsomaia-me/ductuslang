# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
# Runs the checks.
name: checks # the workflow name

on:
  push:
    branches: [main] # only main
  # pull requests too
  pull_request:

env:
  URL: 'https://x.y/z#frag' # quoted hash stays
  NOTE: "a # b \" # c" # real comment
  PLAIN: a#b
  LINK: http://x.y/#anchor
  EMPTY: # nothing here

jobs:
  test:
    runs-on: ubuntu-latest # runner
    steps:
      # check out first
      - uses: actions/checkout@v4 # pinned
      - uses: actions/setup-node@0123456789abcdef0123456789abcdef01234567 # v7.0.0
      - uses: pnpm/action-setup@0123456789abcdef0123456789abcdef01234567 # v1
      - name: Nested
        uses: owner/repo/sub/path@0123456789abcdef0123456789abcdef01234567 # 1.2.3
      - uses: actions/cache@0123456789abcdef0123456789abcdef01234567 # cached for speed
      - uses: actions/cache@v4 # v4.2.0
      - name: Run
        run: |
          echo "# not a comment"
          # not a comment either
          echo done # still part of the script
      - name: Fold
        run: >-
          echo folded # also text
      - name: Keep
        run: |+
          kept

          # text, not a comment

# last comment
