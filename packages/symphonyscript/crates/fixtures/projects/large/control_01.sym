state setpoint_01(0.5)
state phase_01(0)
state alarm_01(false)
state manual_01(false)
state pressures_01([]): f32[..10]
stream reading_01(0.0)
channel[16] fault_01(0)
state demand_01 = setpoint_01 * 0.9
state error_01 = reading_01 - setpoint_01
state lowest_01 = for x in pressures_01 into low from 100.0: min(low, x)
state trend_01 = reading_01.past(1, 0.0) - reading_01.past(2, 0.0)
state mode_01 = if manual_01 then Mode::Manual else Mode::Auto
state gainset_01 = match mode_01:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_01([]) = (history_01.past(1) + [phase_01])[^4..]
stream faults_01 = fault_01 + 1

let ratios_01 = [0.1, 0.25, 0.5, 0.75]
let limits_01 = ratios_01 + [1.0]
let tail_01 = limits_01[2..]
let tag_01 = "plant 01: {tail_01.size}"
let rated_01 = [2kpa, 500pa]
let heavy_01 = if rated_01[0] > 1kpa then 0.5 else 0.25

fn tier_01(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_01(x): 10 ** (x / 20)
fn depth_01(n): if n < 1 then 0 else 1 + depth_01(n - 1)
fn bounded_01(x): clamp(x, 0.0, 1.0)

pattern Bank_01(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_01(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_01 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_01 * 0.01)
    Controller as loop /(demand_01) | gain=gainset_01:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_01(error_01 + trend_01)) | gain=ratio_01(-6)
    for i in 0..4:
        Valve/(ratios_01[i])
    for i, r in tail_01:
        Valve/(r * 0.5) when alarm_01
    Loop_01/(setpoint_01) | gain=heavy_01
    when alarm_01:
        Valve/0.9
    else:
        Valve/(faults_01 * 0.01)
    when:
        phase_01 is 0: Valve/0.6
        phase_01 is 1: Valve/0.7
        else: Valve/(history_01[0] * 0.1)

Plant trim_01:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_01: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_01 manifold_01 /0
Bank_01 header_01 /(tier_01(01) * 0.001)

Plant spare_01 | mode=Off:
    Valve/(depth_01(3) * 0.1)

