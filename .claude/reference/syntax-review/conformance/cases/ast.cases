    Dims as soften /0.5 when a | depth=0.4: stage.wash
    Triggers: match look:
        0: night
        else: dawn
    for i: i32 in 0..8:
        Lamp
    when a:
        Lamp
    else: Lamp
    when:
        b: Lamp
        else: Lamp
