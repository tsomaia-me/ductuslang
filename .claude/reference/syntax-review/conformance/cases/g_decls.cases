#### fn-forms (ok)
fn ratio(x): 10 ** (x / 20)
fn tier(rank: i32, base: i32 = 100) -> i32:
    let cycles: i32 = rank div 4
    base + [0, 5, 15, 40][rank % 4] + 50 * cycles
fn none_params(): 1
fn rise(cell x): x.past(1)
fn g(cell x: i32 = 1, y = x) -> f32?: 1.0
fn m(x):
    match x:
        0: 1
        else: 2
fn fl(xs):
    for x in xs into n from 0:
        n + x
fn lam(xs):
    let keep = p: p > 60
    let big = (p: i32) -> bool: p > 100
    count(xs, keep)
fn mm(x):
    let a = match x:
        0: 1
        else: 2
    let b = for y in ys into s from 0:
        s + y
    a + b
fn gen[T, const N: i32](xs: T[N]) -> T: xs[0]
fn gen2[T: f32 | f64](a: T, b: T) -> T: (a + b) / 2
fn takes(f: (i32) -> bool, g: (x: f64, y: f64) -> f64, h: () -> i32): 1
