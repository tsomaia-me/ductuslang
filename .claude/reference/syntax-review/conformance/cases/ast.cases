#### fns
fn tier(cell rank: i32, base: i32 = 100, plain, d = 1) -> i32:
    let cycles: i32 = rank div 4
    base + cycles
fn gen[T: f32 | f64, const N: i32](xs: T[N]) -> T: xs[0]
fn m(x):
    match x:
        0: 1
        else: 2
#### patterns
pattern Drum[K](default out channel hit: Hit, gain: f32 = 1.0, const n = 2, children notes: Note*, plain) -> (Pad, [Lamp{2+}]*, node+):
    state g(1.0)
    let k = 2
    Pad | hit => hit gain=gain
    notes
