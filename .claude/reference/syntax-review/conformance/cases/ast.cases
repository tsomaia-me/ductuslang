#### cells
state setpoint(0.5)
channel[16] alarm(0)
state name(""): str[..32]
state c2 on b = a + b
state c4 on (a, b) = a + b
state held(0.0): f64 on gate = if gate then level else held.past(1)
state level = match mode:
    Auto: 1.0
    else: 0.6
state high = for x in readings into kept from []:
    let keep = x > 60
    if keep then kept + [x] else kept
state s: i32[3] = [1, 2, 3]
