state section_13(0)
state fill_13(false)
state cutoff_13(0.5)
state drive_13(0.25)
state held_13([]): i32[..12]
stream pulse_13(0)
channel[8] hits_13(0)
state swing_13 = cutoff_13 * 0.8
state bright_13 = if fill_13 then swing_13 else cutoff_13.past(1, 0.5)
stream beat_13 = pulse_13 + hits_13
state last_13 = section_13.past(1, -1)
state recent_13([]) = (recent_13.past(1) + [section_13])[^8..]
state peak_13 = for x in recent_13 into top from 0: max(top, x)
state played_13 = held_13 + [last_13]
state rising_13 = for i in 1..held_13.size into n from 0: if held_13[i] > held_13[i - 1] then n + 1 else n
state mood_13 = match section_13 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_13 = match fill_13:
    true: Wave::Saw
    false: Wave::Sine

let scale_13 = [0, 2, 4, 5, 7, 9, 11]
let chords_13 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_13 = 36 + 13 % 12
let span_13 = scale_13 + [12, 14, 16]
let upper_13 = span_13[3..8]
let lower_13 = span_13[..3]
let label_13 = "part 13"
let title_13 = "{label_13} in {root_13}"
let lengths_13 = [1bars, 2, 0.5bars]

fn degree_13(i): root_13 + scale_13[i % 7] + 12 * (i div 7)
fn fib_13(n): if n < 2 then n else fib_13(n - 1) + fib_13(n - 2)
fn level_13(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_13(i, shift = 0):
    let base = chords_13[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_13(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_13 = [fib_13(3), fib_13(4), fib_13(5), fib_13(6)]
let total_13 = for s in steps_13 into sum from 0: sum + s
let ladder_13 = for i in 0..6 into kept from []: kept + [degree_13(i)]
let voiced_13 = chord_13(13, 12)

pattern Arp_13(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_13(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_13

pattern Stab_13(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_13 | gain=0.9:
    Note/(root_13) Note/(root_13 + 4) Note/(root_13 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_13(1)) Note as top /(degree_13(3)) Note'/(degree_13(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_13)
    (Note' as mark /61 when fill_13 | velocity=0.5)
    Note/(section_13 + 1)
    Note'/62 | velocity=level_13(drive_13) brightness=bright_13
               length=2bars
    Note/(peak_13 + root_13) | length=lengths_13[0]
    Arp_13/(root_13) | steps=3
    Arp_13/(root_13 + 12) | gap=gap_13(13)
    Plays | transpose=5: verse_13
    Starts: [verse_13, chorus_13][section_13]

Clip verse_13:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_13
    for i in 0..8:
        Note/(degree_13(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_13:
        Note/(root_13 + p) | brightness=0.1 * i
    Voice_13 as low /(root_13)
    Voice_13/(root_13 + 7) | steps=2
    Stab_13/(voiced_13[0]) | loud
    Plays: chorus_13

Clip chorus_13 | gain=verse_13.gain * 1.2:
    Note/72 | velocity=verse_13.hook.velocity
    for c in chords_13:
        [Note/(root_13 + c[0]) Note/(root_13 + c[1]) Note/(root_13 + c[2])]
    when fill_13:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_13 is 0: Note/77
        section_13 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_13[i])]
    Plays as back | transpose=-2: verse_13
    Plays: bridge_13
    Plays | gain=to.hook.velocity: verse_13

Clip bridge_13 | level=mood_13:
    for i in 0..total_13:
        Note/(root_13 + i % 12) | velocity=0.5 length=lengths_13[1]
    Note/(played_13[0]) | velocity=level_13(cutoff_13, 0.2)
    Note/(rising_13 + 40)
    Plays when fill_13: intro_13

Synth rack_13:
    Osc as lead /(220.0 + 13) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_13
    Filter as lp /(1000.0 + 13 * 10.0):
        Feeds: mix
        Feeds when fill_13: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_13 | label=title_13:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_13

Kit kit_13:
    for i in 0..4:
        Sampler | file="kit/13/{i}.wav"

