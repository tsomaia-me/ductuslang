state section_19(0)
state fill_19(false)
state cutoff_19(0.5)
state drive_19(0.25)
state held_19([]): i32[..12]
stream pulse_19(0)
channel[8] hits_19(0)
state swing_19 = cutoff_19 * 0.8
state bright_19 = if fill_19 then swing_19 else cutoff_19.past(1, 0.5)
stream beat_19 = pulse_19 + hits_19
state last_19 = section_19.past(1, -1)
state recent_19([]) = (recent_19.past(1) + [section_19])[^8..]
state peak_19 = for x in recent_19 into top from 0: max(top, x)
state played_19 = held_19 + [last_19]
state rising_19 = for i in 1..held_19.size into n from 0: if held_19[i] > held_19[i - 1] then n + 1 else n
state mood_19 = match section_19 % 4:
    0: 0.25
    1: 0.5
    2: 0.75
    else: 1.0
state wave_19 = match fill_19:
    true: Wave::Saw
    false: Wave::Sine

let scale_19 = [0, 2, 4, 5, 7, 9, 11]
let chords_19 = [[0, 4, 7], [5, 9, 12], [7, 11, 14], [9, 12, 16]]
let root_19 = 36 + 19 % 12
let span_19 = scale_19 + [12, 14, 16]
let upper_19 = span_19[3..8]
let lower_19 = span_19[..3]
let label_19 = "part 19"
let title_19 = "{label_19} in {root_19}"
let lengths_19 = [1bars, 2, 0.5bars]

fn degree_19(i): root_19 + scale_19[i % 7] + 12 * (i div 7)
fn fib_19(n): if n < 2 then n else fib_19(n - 1) + fib_19(n - 2)
fn level_19(x, k = 0.1): min(1.0, x * 0.5 + k)
fn chord_19(i, shift = 0):
    let base = chords_19[i % 4]
    [base[0] + shift, base[1] + shift, base[2] + shift]
fn gap_19(i):
    match i % 3:
        0: 4
        1: 3
        else: 5

let steps_19 = [fib_19(3), fib_19(4), fib_19(5), fib_19(6)]
let total_19 = for s in steps_19 into sum from 0: sum + s
let ladder_19 = for i in 0..6 into kept from []: kept + [degree_19(i)]
let voiced_19 = chord_19(19, 12)

pattern Arp_19(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Voice_19(default root, steps = 3, gain = 0.8):
    for i in 0..steps:
        Note/(root + i) | velocity=gain
    Starts: intro_19

pattern Stab_19(default pitch, loud = false):
    [Note/pitch Note/(pitch + 4) Note/(pitch + 7)]
    Note'/(pitch + 12) when loud

Clip intro_19 | gain=0.9:
    Note/(root_19) Note/(root_19 + 4) Note/(root_19 + 7)
    [Note/60 Note/64 Note/67]
    [Note/(degree_19(1)) Note as top /(degree_19(3)) Note'/(degree_19(5))]
    Note/50 (Note/53 | velocity=0.5 accent brightness=swing_19)
    (Note' as mark /61 when fill_19 | velocity=0.5)
    Note/(section_19 + 1)
    Note'/62 | velocity=level_19(drive_19) brightness=bright_19
               length=2bars
    Note/(peak_19 + root_19) | length=lengths_19[0]
    Arp_19/(root_19) | steps=3
    Arp_19/(root_19 + 12) | gap=gap_19(19)
    Plays | transpose=5: verse_19
    Starts: [verse_19, chorus_19][section_19]

Clip verse_19:
    Note as hook /65 | velocity=0.9
    Note/67 when fill_19
    for i in 0..8:
        Note/(degree_19(i)) | velocity=0.4 + i * 0.05
    for i, p in upper_19:
        Note/(root_19 + p) | brightness=0.1 * i
    Voice_19 as low /(root_19)
    Voice_19/(root_19 + 7) | steps=2
    Stab_19/(voiced_19[0]) | loud
    Plays: chorus_19

Clip chorus_19 | gain=verse_19.gain * 1.2:
    Note/72 | velocity=verse_19.hook.velocity
    for c in chords_19:
        [Note/(root_19 + c[0]) Note/(root_19 + c[1]) Note/(root_19 + c[2])]
    when fill_19:
        Note/74 Note/76
    else:
        Note/73
    when:
        section_19 is 0: Note/77
        section_19 is 1: Note/79
        else: Note/81
    [for i in 0..3: Note/(ladder_19[i])]
    Plays as back | transpose=-2: verse_19
    Plays: bridge_19
    Plays | gain=to.hook.velocity: verse_19

Clip bridge_19 | level=mood_19:
    for i in 0..total_19:
        Note/(root_19 + i % 12) | velocity=0.5 length=lengths_19[1]
    Note/(played_19[0]) | velocity=level_19(cutoff_19, 0.2)
    Note/(rising_19 + 40)
    Plays when fill_19: intro_19

Synth rack_19:
    Osc as lead /(220.0 + 19) | wave=Saw rate=0.5:
        Feeds: lp
        Modulates | depth=0.3: lp
    Osc as sub /110.0 | wave=wave_19
    Filter as lp /(1000.0 + 19 * 10.0):
        Feeds: mix
        Feeds when fill_19: sink
    Osc as tuned /(tuning * 0.5) | rate=master
    Mixer as mix
    Output as sink

Track lane_19 | label=title_19:
    Piano
    Synth:
        Osc/440.0 | wave=Square
    Starts: intro_19

Kit kit_19:
    for i in 0..4:
        Sampler | file="kit/19/{i}.wav"

