state demand(0.5)
state manual(false)
state override(Mode::Manual)
stream level(0.0)
channel[8] alarms(0)

state setpoint = if manual then demand else 0.6
let stages = [0.25, 0.5, 0.75]

pattern Loop(default target, response = 1.0):
    Controller/target | gain=response

Plant boiler | mode=Auto:
    Sensor as gauge /level:
        Reads: hold
    Valve as feed /demand
    Valve as vent
    Controller as hold /setpoint | gain=0.5:
        Drives | limit=0.8: feed
        Drives when alarms > 0: vent
