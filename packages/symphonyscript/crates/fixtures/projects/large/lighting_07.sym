state intensity_25(0.5)
state look_25(0)
state flash_25(false)
state chase_25([true, false, false, true, false, false, true, false])
state levels_25([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_25(0)
channel[4] go_25(0)
state glow_25 = intensity_25 * 0.8
state fade_in_25 = intensity_25.past(2, 0.0)
state pace_25 = if flash_25 then 200ms else 1.5s
state dimmed_25 = for x in levels_25 into sum from 0.0: sum + x * intensity_25
stream count_25 = tick_25 + go_25
channel bursts_25 = go_25 * 2
state moved_25 = intensity_25.stepped
state step_25 = (look_25 + 1) % 8

let ramp_25 = [0.2, 0.5, 0.8]
let hues_25 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_25 = hues_25[..3]
let cool_25 = hues_25[^3..]
let palette_25 = warm_25 + cool_25
let name_25 = "rig 25"
let holds_25 = [2s, 500ms, 4]

fn bounce_25(n): if n < 1 then 0.0 else 0.1 + bounce_25(n - 1)
fn spread_25(i, width = 0.25): (i % 4) * width
fn tint_25(i):
    let base = palette_25[i % 6]
    min(1.0, base + 0.05)

pattern Chase_25(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_25(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_25(i)

pattern Flash_25(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_25:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_25)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_25
    Lamp as wash /0.7 | hue=glow_25 strobe
    Lamp as spot /(bounce_25(4)) | hue=fade_in_25
    Lamp*/0.3 when flash_25
    Lamp/(bursts_25 * 0.1) when moved_25
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_25: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_25[i]) when chase_25[i]
    for i, p in ramp_25:
        Lamp/p | hue=spread_25(i)
    Wash_25/(intensity_25) | count=4
    Flash_25/0.1
    when flash_25:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_25 is 0: Lamp/0.25
        look_25 is 1: Lamp/0.5
        else: Lamp/(dimmed_25 * 0.1)

Scene night_25 | hold=holds_25[0]:
    Cue/0
    Cue | at=step_25 fade=1s
    Triggers: [stage_25.dusk, dawn_25][look_25]

Scene dawn_25:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_25 then night_25 else stage_25.dusk

Chase_25 loop_25 /0 | again=loop_25

