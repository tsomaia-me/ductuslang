state setpoint_21(0.5)
state phase_21(0)
state alarm_21(false)
state manual_21(false)
state pressures_21([]): f32[..10]
stream reading_21(0.0)
channel[16] fault_21(0)
state demand_21 = setpoint_21 * 0.9
state error_21 = reading_21 - setpoint_21
state lowest_21 = for x in pressures_21 into low from 100.0: min(low, x)
state trend_21 = reading_21.past(1, 0.0) - reading_21.past(2, 0.0)
state mode_21 = if manual_21 then Mode::Manual else Mode::Auto
state gainset_21 = match mode_21:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_21([]) = (history_21.past(1) + [phase_21])[^4..]
stream faults_21 = fault_21 + 1

let ratios_21 = [0.1, 0.25, 0.5, 0.75]
let limits_21 = ratios_21 + [1.0]
let tail_21 = limits_21[2..]
let tag_21 = "plant 21: {tail_21.size}"
let rated_21 = [2kpa, 500pa]
let heavy_21 = if rated_21[0] > 1kpa then 0.5 else 0.25

fn tier_21(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_21(x): 10 ** (x / 20)
fn depth_21(n): if n < 1 then 0 else 1 + depth_21(n - 1)
fn bounded_21(x): clamp(x, 0.0, 1.0)

pattern Bank_21(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_21(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_21 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_21 * 0.01)
    Controller as loop /(demand_21) | gain=gainset_21:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_21(error_21 + trend_21)) | gain=ratio_21(-6)
    for i in 0..4:
        Valve/(ratios_21[i])
    for i, r in tail_21:
        Valve/(r * 0.5) when alarm_21
    Loop_21/(setpoint_21) | gain=heavy_21
    when alarm_21:
        Valve/0.9
    else:
        Valve/(faults_21 * 0.01)
    when:
        phase_21 is 0: Valve/0.6
        phase_21 is 1: Valve/0.7
        else: Valve/(history_21[0] * 0.1)

Plant trim_21:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_21: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_21 manifold_21 /0
Bank_21 header_21 /(tier_21(21) * 0.001)

Plant spare_21 | mode=Off:
    Valve/(depth_21(3) * 0.1)

