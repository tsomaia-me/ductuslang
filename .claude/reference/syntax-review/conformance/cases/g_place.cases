#### when-forms (ok)
Plant boiler:
    Valve/0.1
    when alarm_on:
        Valve/0.3 Valve/0.5
    else:
        Valve/0.3
    when:
        phase is 0: Valve/0.6
        phase is 1: Valve/0.7
        else: Valve/0.9
    when a: Valve
    when a: Valve
    else: Valve Valve
    when a:
        Valve
    else: Valve
    when:
        a:
            Valve
        b: Valve
    when:
        a: Valve
        else:
            Valve
    when a and (b or c):
        when d: Valve
        else:
            for i in 0..3: Valve
    when x is none: Valve
    when x is i32: Valve
    when f(y): Valve
    when flag: Valve
