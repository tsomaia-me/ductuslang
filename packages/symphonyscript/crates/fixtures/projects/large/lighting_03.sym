state intensity_09(0.5)
state look_09(0)
state flash_09(false)
state chase_09([true, false, false, true, false, false, true, false])
state levels_09([0.2, 0.2, 0.8, 0.2, 0.5, 0.2, 0.8, 1.0])
stream tick_09(0)
channel[4] go_09(0)
state glow_09 = intensity_09 * 0.8
state fade_in_09 = intensity_09.past(2, 0.0)
state pace_09 = if flash_09 then 200ms else 1.5s
state dimmed_09 = for x in levels_09 into sum from 0.0: sum + x * intensity_09
stream count_09 = tick_09 + go_09
channel bursts_09 = go_09 * 2
state moved_09 = intensity_09.stepped
state step_09 = (look_09 + 1) % 8

let ramp_09 = [0.2, 0.5, 0.8]
let hues_09 = for i in 0..6 into kept from []: kept + [i * 0.15]
let warm_09 = hues_09[..3]
let cool_09 = hues_09[^3..]
let palette_09 = warm_09 + cool_09
let name_09 = "rig 09"
let holds_09 = [2s, 500ms, 4]

fn bounce_09(n): if n < 1 then 0.0 else 0.1 + bounce_09(n - 1)
fn spread_09(i, width = 0.25): (i % 4) * width
fn tint_09(i):
    let base = palette_09[i % 6]
    min(1.0, base + 0.05)

pattern Chase_09(default start, again):
    Scene:
        Cue/start Cue/(start + 1)
        Triggers: again

pattern Wash_09(default level, count = 3):
    for i in 0..count:
        Lamp/level | hue=tint_09(i)

pattern Flash_09(default start):
    [Lamp/start Lamp/(start + 0.3) Lamp*/(start + 0.6)]

Rig stage_09:
    Scene as dusk | hold=8:
        Cue/0 Cue/2 (Cue | at=500ms fade=pace_09)
        Dims: wash
        Dims | depth=to.level: spot
        Triggers: night_09
    Lamp as wash /0.7 | hue=glow_09 strobe
    Lamp as spot /(bounce_09(4)) | hue=fade_in_09
    Lamp*/0.3 when flash_09
    Lamp/(bursts_09 * 0.1) when moved_09
    Lamp/(db(-6)) | hue=master * 0.5
    [Lamp/0.2 Lamp/0.5 Lamp/0.8]
    [for i in 0..3: Lamp/(0.2 + i * 0.3)]
    [for i, p in ramp_09: (Lamp/p | hue=1.0 - i * 0.2)]
    for i in 0..8:
        Lamp/(levels_09[i]) when chase_09[i]
    for i, p in ramp_09:
        Lamp/p | hue=spread_09(i)
    Wash_09/(intensity_09) | count=4
    Flash_09/0.1
    when flash_09:
        Lamp/1.0 Lamp/0.9
    else:
        Lamp/0.4
    when:
        look_09 is 0: Lamp/0.25
        look_09 is 1: Lamp/0.5
        else: Lamp/(dimmed_09 * 0.1)

Scene night_09 | hold=holds_09[0]:
    Cue/0
    Cue | at=step_09 fade=1s
    Triggers: [stage_09.dusk, dawn_09][look_09]

Scene dawn_09:
    Cue/(2s) Cue/(3000ms)
    Triggers: if flash_09 then night_09 else stage_09.dusk

Chase_09 loop_09 /0 | again=loop_09

