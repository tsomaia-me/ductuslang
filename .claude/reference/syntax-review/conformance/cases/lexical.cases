#### comment-eol [tokens]
let a = 1 // comment ; == != ^ "
// whole line
let b = 2 //
#### comment-in-string-is-text [tokens]
let a = "http://x // not a comment"
#### comment-in-interpolation (starts comment => string unterminated)
let a = "x {1 // c} y"
#### no-block-comment (error)
let a = 1 /* c */ + 2
#### slash-slash-after-kind-is-comment [tokens]
Rig r:
    Lamp//0.5
#### ident-hash-forms [tokens]
let C#4 = 1
let lamp#2 = C#4
let #1 = 2
let _x = 3
let x_ = 4
let _#a = 5
let a# = 6
#### ident-only-underscore (error)
let _ = 1
#### ident-only-underscores-hash (error)
