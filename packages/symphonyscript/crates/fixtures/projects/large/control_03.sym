state setpoint_09(0.5)
state phase_09(0)
state alarm_09(false)
state manual_09(false)
state pressures_09([]): f32[..10]
stream reading_09(0.0)
channel[16] fault_09(0)
state demand_09 = setpoint_09 * 0.9
state error_09 = reading_09 - setpoint_09
state lowest_09 = for x in pressures_09 into low from 100.0: min(low, x)
state trend_09 = reading_09.past(1, 0.0) - reading_09.past(2, 0.0)
state mode_09 = if manual_09 then Mode::Manual else Mode::Auto
state gainset_09 = match mode_09:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
state history_09([]) = (history_09.past(1) + [phase_09])[^4..]
stream faults_09 = fault_09 + 1

let ratios_09 = [0.1, 0.25, 0.5, 0.75]
let limits_09 = ratios_09 + [1.0]
let tail_09 = limits_09[2..]
let tag_09 = "plant 09: {tail_09.size}"
let rated_09 = [2kpa, 500pa]
let heavy_09 = if rated_09[0] > 1kpa then 0.5 else 0.25

fn tier_09(rank, base = 100): base + [0, 5, 15, 40][rank % 4] + 50 * (rank div 4)
fn ratio_09(x): 10 ** (x / 20)
fn depth_09(n): if n < 1 then 0 else 1 + depth_09(n - 1)
fn bounded_09(x): clamp(x, 0.0, 1.0)

pattern Bank_09(default base):
    Plant:
        Valve/base Valve/(base + 0.25) Valve/(base + 0.5)

pattern Loop_09(default target, gain = 1.0):
    Controller/target | gain=gain

Plant boiler_09 | mode=Manual:
    Valve as feed /0.2
    Valve as bleed /(lowest_09 * 0.01)
    Controller as loop /(demand_09) | gain=gainset_09:
        Drives | limit=to.open: feed
        Drives as choke | limit=0.3: bleed
    Controller/(bounded_09(error_09 + trend_09)) | gain=ratio_09(-6)
    for i in 0..4:
        Valve/(ratios_09[i])
    for i, r in tail_09:
        Valve/(r * 0.5) when alarm_09
    Loop_09/(setpoint_09) | gain=heavy_09
    when alarm_09:
        Valve/0.9
    else:
        Valve/(faults_09 * 0.01)
    when:
        phase_09 is 0: Valve/0.6
        phase_09 is 1: Valve/0.7
        else: Valve/(history_09[0] * 0.1)

Plant trim_09:
    Valve/(master * 0.5)
    Controller/(db(-12)) | gain=master

Plant topup_09: Valve/0 Valve/0.5 (Controller/0.4 | gain=0.5)

Bank_09 manifold_09 /0
Bank_09 header_09 /(tier_09(09) * 0.001)

Plant spare_09 | mode=Off:
    Valve/(depth_09(3) * 0.1)

