#### match-forms (ok)
let a = match mode:
    Auto: 1.0
    Manual: 0.8
    else: 0.6
let b = match n:
    0: 1
    -1: 2
    0x10: 3
    5ms: 4
    else: 9
let c = match s:
    "a": 1
    "b": 2
    else: 3
let d = match f:
    true: 1
    false: 0
let e = match shape:
    Circle: pi * shape.r * shape.r
    Square: shape.side * shape.side
    none: 0
    i32: 1
    str[..8]: 2
    i32[3]: 3
    lib::Tri: 4
    Stack[i32, 8]: 5
    json: 6
    json[..8]: 7
    {str[..4]: i32}[..8]: 8
    bool: 9
    f64: 10
let f = match x + 1:
    1: if a then 1 else 2
    else: 3
#### match-no-arms (refuse)
let a = match x:
let b = 1
#### match-only-else (refuse)
let a = match x:
    else: 1
#### match-else-not-last (refuse)
let a = match x:
    0: 1
    else: 2
    1: 3
#### match-two-else (refuse)
let a = match x:
    0: 1
    else: 2
    else: 3
#### match-arm-block (refuse)
let a = match x:
    0:
        1
    else: 2
#### match-arm-expr-label (refuse)
let a = match x:
    1 + 1: 1
    else: 2
#### match-arm-neg-name (refuse)
let a = match x:
    -y: 1
    else: 2
#### match-arm-two-labels (refuse)
let a = match x:
    0, 1: 1
    else: 2
#### match-arm-paren-type (refuse)
let a = match x:
    (i32): 1
    else: 2
#### match-arm-sum-type (refuse)
let a = match x:
    i32 | f32: 1
    else: 2
#### match-as-operand (refuse)
let a = 1 + match x:
    0: 1
    else: 2
#### match-in-parens (refuse)
let a = (match x:
    0: 1
    else: 2)
#### match-as-argument (refuse)
let a = f(match x:
    0: 1
    else: 2)
#### match-as-attr-value (refuse)
Rig r | x=match y:
    0: 1
    else: 2
#### match-as-gate (refuse)
Rig r:
    Lamp when match y:
        0: true
        else: false
#### match-as-arm-value (refuse)
let a = match x:
    0: match y:
        0: 1
        else: 2
    else: 2
#### match-inline-arms (refuse)
let a = match x: 0: 1
#### match-arm-for-unparenthesized (refuse)
let a = match x:
    0: for y in ys into s from 0: s + y
    else: 2
#### match-in-pattern-let-and-cell (ok)
pattern P(mode):
    let a = match mode:
        Auto: 1
        else: 2
    state s = match mode:
        Auto: 1
        else: 2
    Lamp/a
