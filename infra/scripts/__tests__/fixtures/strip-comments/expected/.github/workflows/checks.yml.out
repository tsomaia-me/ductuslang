# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
name: checks

on:
  push:
    branches: [main]
  pull_request:

env:
  URL: 'https://x.y/z#frag'
  NOTE: "a # b \" # c"
  PLAIN: a#b
  LINK: http://x.y/#anchor
  EMPTY:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@0123456789abcdef0123456789abcdef01234567 # v7.0.0
      - uses: pnpm/action-setup@0123456789abcdef0123456789abcdef01234567 # v1
      - name: Nested
        uses: owner/repo/sub/path@0123456789abcdef0123456789abcdef01234567 # 1.2.3
      - uses: actions/cache@0123456789abcdef0123456789abcdef01234567
      - uses: actions/cache@v4
      - name: Run
        run: |
          echo "# not a comment"
          # not a comment either
          echo done # still part of the script
      - name: Fold
        run: >-
          echo folded # also text
      - name: Keep
        run: |+
          kept

          # text, not a comment

