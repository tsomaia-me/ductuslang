#!/usr/bin/env bash
# Usage: .agents/bin/claude_worker <agent: builder|explorer|reviewer> <task_prompt> [optional_model] [optional_effort]

AGENT="$1"
TASK="$2"
MODEL_ARGS=()
[ -n "$3" ] && MODEL_ARGS+=(--model "$3")
[ -n "$4" ] && MODEL_ARGS+=(--effort "$4")

claude -p "$TASK" \
  --agent "$AGENT" \
  --no-session-persistence \
  "${MODEL_ARGS[@]}"
