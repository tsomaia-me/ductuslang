pattern Arp(default root, steps = 4, gap = 4):
    for i in 0..steps:
        Note/(root + i * gap)

pattern Chord(default root, third = 4, fifth = 7):
    [Note/root Note/(root + third) Note/(root + fifth)]

pattern Hit(default root, loud = false):
    Note/root | accent=loud

pattern Phrase(default root, rise = 2):
    let peak = root + rise * 3
    Note as bottom /root
    Note as top /peak | velocity=0.9
    Arp/peak | steps=rise

pattern Riff(default root):
    Clip:
        Note/root Note/(root + 7) Note/(root + 12)

Session main:
    Includes: keys

